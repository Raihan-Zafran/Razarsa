<?xml version="1.0" encoding="utf-8"?>
<!-- Data Razarsa hanya ada di HP ini: tidak ikut cadangan Google maupun pindah HP otomatis,
     jadi menghapus aplikasi benar-benar menghapus datanya. Pindah data lewat Backup di Pengaturan. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
